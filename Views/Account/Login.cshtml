@using RouteRevisionHub.Services
@{
    ViewData["Title"] = "Sign In with Google Drive";
    Layout = "_Layout";
    bool isConfigured = ViewBag.IsGoogleConfigured is true;
    var roots = ViewBag.RootFolders as List<DriveRootFolderConfig> ?? new List<DriveRootFolderConfig>();
    string returnUrl = ViewBag.ReturnUrl as string ?? "/";
    string callbackUrl = ViewBag.CallbackUrl as string ?? "/signin-google";
    string? oauthError = ViewBag.OAuthError as string;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="hub-card p-4 p-lg-5 border-info">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="badge bg-info text-dark">RouteRevisionHub · Online</span>
                <span class="badge bg-success">Google Drive Access Guard</span>
            </div>

            <h1 class="h3 fw-bold mb-2">تسجيل الدخول عبر Google Drive الخاص بالكورس</h1>
            <p class="text-muted-hub rtl-ar mb-4">
                هذا البورتال محمي بصلاحيات <strong class="text-info">Google Drive ACL</strong> مباشرة:
                يجب تسجيل الدخول بنفس حساب Google المُصرّح له بفتح مجلدات الكورس (مثل <code>Eng Hossam Mostafa</code> والورش) حتى يتم السماح بعرض المحتوى أو تشغيل الفيديوهات.
            </p>

            @if (!string.IsNullOrWhiteSpace(oauthError))
            {
                <div class="alert alert-warning small mb-3">
                    <strong>تنبيه تسجيل الدخول:</strong> افتح التطبيق من <code>@($"{Context.Request.Scheme}://{Context.Request.Host}")</code> واضغط زر <strong>Sign in with Google Account</strong> بالأسفل لبدء الجلسة (رابط <code>/signin-google</code> مخصص لاستقبال الرد التلقائي من Google فقط).<br />
                    <span class="text-muted-hub">(@oauthError)</span>
                </div>
            }

            @if (isConfigured)
            {
                <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="forceSelectAccount" value="true" />
                    <button type="submit" class="btn btn-info text-dark fw-bold btn-lg w-100">
                        🔐 Sign in with Google Account (Verify Drive Access)
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-warning mb-4">
                    <div class="fw-bold mb-1">⚙️ إعداد OAuth مطلوب للتشغيل الأونلاين (مرة واحدة فقط)</div>
                    <div class="small mb-2">
                        أضف بيانات Google Cloud OAuth Client في ملف <code>appsettings.json</code> أو في <code>Environment Variables</code> على الاستضافة:
                    </div>
                    <pre class="code-box small ltr-code mb-2"><code>"Authentication": {
  "Google": {
    "ClientId": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR_CLIENT_SECRET"
  }
}</code></pre>
                    <div class="small">
                        <strong>Authorized Redirect URI in Google Cloud Console:</strong><br />
                        <code class="text-info">@callbackUrl</code>
                    </div>
                </div>
            }

            <h2 class="h6 fw-bold text-uppercase text-muted-hub mb-2">المجلدات المرتبطة للتحقق من الصلاحية:</h2>
            <div class="d-flex flex-column gap-2">
                @foreach (var r in roots)
                {
                    <div class="p-2 px-3 rounded border d-flex justify-content-between align-items-center" style="border-color:var(--border)!important;background:var(--bg)">
                        <div>
                            <span class="badge @(r.Required ? "bg-warning text-dark" : "bg-secondary") me-2">@(r.Required ? "Required Access" : r.Role)</span>
                            <strong>@r.Label</strong>
                        </div>
                        <small class="text-muted-hub ltr-code">@r.FolderId</small>
                    </div>
                }
            </div>
            <div class="mt-3 pt-2 border-top small text-muted-hub ltr-code" style="border-color:var(--border)!important">
                OAuth Callback: <code>@callbackUrl</code>
            </div>
        </div>
    </div>
</div>
