@model RouteRevisionHub.Controllers.ExamResultViewModel
@{
    var sub = Model.Submission;
    ViewData["Title"] = $"Result: {sub.ChapterExam.Title}";
}

<div class="hub-card p-4 mb-4" style="border-color:@(sub.Passed ? "var(--success)" : "var(--danger)")!important">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge @(sub.Passed ? "bg-success" : "bg-danger") mb-2">
                @(sub.Passed ? "✓ PASSED CHAPTER EXAM" : "✗ NEEDS MORE REVISION")
            </span>
            <h1 class="h3 fw-bold mb-1">@sub.ChapterExam.Title</h1>
            <div class="small text-muted-hub">
                Completed in @TimeSpan.FromSeconds(sub.DurationSecondsUsed).ToString(@"mm\:ss") · Passing threshold: @sub.ChapterExam.PassingScorePercent%
            </div>
        </div>
        <div class="text-end">
            <div class="display-5 fw-bold @(sub.Passed ? "text-success" : "text-danger")">@sub.ScorePercent%</div>
            <div class="small text-muted-hub">@sub.CorrectAnswers / @sub.TotalQuestions Correct</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <a asp-action="Take" asp-route-id="@sub.ChapterExamId" class="btn btn-sm btn-warning text-dark fw-semibold">↻ Retake Exam</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-info">← Back to Chapter Exams</a>
        <a asp-controller="Checklist" asp-action="Index" class="btn btn-sm btn-outline-success">✓ Go to Checklist</a>
    </div>
</div>

<h2 class="h5 fw-bold mb-3">Detailed Question-by-Question Review (@Model.Items.Count)</h2>
<div class="d-flex flex-column gap-3">
    @for (int i = 0; i < Model.Items.Count; i++)
    {
        var item = Model.Items[i];
        <div class="hub-card p-3" style="border-left:4px solid @(item.IsCorrect ? "var(--success)" : "var(--danger)")">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div>
                    <span class="badge @(item.IsCorrect ? "bg-success" : "bg-danger") me-1">@(item.IsCorrect ? "✓ Correct" : "✗ Wrong")</span>
                    <span class="small text-muted-hub">Q@(i + 1) · @item.QuestionType</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Topics" asp-action="Details" asp-route-id="@item.TopicSlug" class="small text-info text-decoration-none">Review @item.TopicTitle →</a>
                    @if (!item.IsCorrect)
                    {
                        <button type="button" onclick="flagNeedsReview(@item.TopicId, this)" class="btn btn-sm btn-outline-warning">🚩 Flag NeedsReview</button>
                    }
                </div>
            </div>
            <div class="fw-semibold mb-2">@item.Prompt</div>
            <div class="small mb-1"><strong>Your Answer:</strong> <span class="@(item.IsCorrect ? "text-success" : "text-danger")">@item.SelectedAnswer</span></div>
            @if (!item.IsCorrect)
            {
                <div class="small mb-1"><strong>Correct Answer:</strong> <span class="text-success">@item.CorrectAnswer</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(item.Explanation))
            {
                <div class="small text-muted-hub mt-1">💡 @item.Explanation</div>
            }
            @if (!string.IsNullOrWhiteSpace(item.SourceCitation))
            {
                <div class="small text-muted-hub mt-1">📌 Source: @item.SourceCitation</div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
async function flagNeedsReview(topicId, btn) {
    const resp = await fetch("/api/progress", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ topicId, status: "NeedsReview", confidenceLevel: 2, userNotes: null, incrementReview: false })
    });
    if (resp.ok) {
        btn.disabled = true;
        btn.textContent = "✓ Flagged NeedsReview";
    }
}
</script>
}
