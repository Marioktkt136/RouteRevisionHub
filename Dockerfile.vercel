FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["RouteRevisionHub.Online.csproj", "./"]
RUN dotnet restore "RouteRevisionHub.Online.csproj"

COPY . .
RUN dotnet publish "RouteRevisionHub.Online.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 80

CMD ["sh", "-c", "ASPNETCORE_URLS=http://0.0.0.0:${PORT:-80} dotnet RouteRevisionHub.Online.dll"]
