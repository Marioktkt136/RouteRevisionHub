@model RouteRevisionHub.ViewModels.ConventionGlossaryViewModel
@{
    ViewData["Title"] = "Convention Keys Cheat Sheet";
}

<h1 class="h3 fw-bold mb-1">🔑 Master Convention Keys & Syntax Glossary</h1>
<p class="small text-muted-hub mb-3">Every C#, OOP, MS SQL Server, LINQ, EF Core, and ASP.NET Core MVC rule, naming convention, and keyword in one place.</p>

<form method="get" asp-action="Conventions" class="hub-card p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small text-muted-hub mb-1">Filter Key or Rule</label>
            <input type="text" name="q" value="@Model.Query" class="form-control form-control-sm hub-input" placeholder="Search AsNoTracking, Id, TPH, OFFSET, CLUSTERED..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted-hub mb-1">Category</label>
            <select name="category" class="form-select form-select-sm hub-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat" selected="@(Model.Category == cat)">@cat</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="criticalOnly" value="true" checked="@Model.CriticalOnly" id="chkCrit" />
                <label class="form-check-label small" for="chkCrit">Critical Only</label>
            </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-info btn-sm text-dark fw-semibold flex-grow-1">Apply</button>
            <a asp-action="Conventions" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </div>
</form>

<div class="hub-card p-3">
    <div class="small text-muted-hub mb-2">Showing <strong>@Model.Keys.Count</strong> convention keys</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0" style="color:var(--text)">
            <thead>
                <tr class="small text-muted-hub" style="border-color:var(--border)">
                    <th>Key / Rule</th>
                    <th>Category</th>
                    <th>Topic</th>
                    <th>Short Rule</th>
                    <th>Snippet</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.Keys)
                {
                    <tr style="border-color:var(--border)">
                        <td><span class="key-pill @(k.IsCritical ? "critical" : "")">@k.KeyName</span></td>
                        <td><span class="badge bg-secondary">@k.Category</span></td>
                        <td class="small">
                            <a asp-controller="Topics" asp-action="Details" asp-route-id="@k.Topic.Slug" class="text-info text-decoration-none">
                                [@k.Topic.TrackModule.Code] @k.Topic.TitleEn
                            </a>
                        </td>
                        <td class="small">@k.ShortRule</td>
                        <td class="small ltr-code">@if (!string.IsNullOrEmpty(k.ExampleSnippet)){<code>@k.ExampleSnippet</code>}</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
